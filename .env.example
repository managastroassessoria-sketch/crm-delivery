# ============================================================
# CRM Delivery — variáveis de ambiente
# Copie para .env.local e preencha. O .env.local NÃO vai para o Git.
# Conferir:  npm run env:check
# ============================================================

# --- Geral ---------------------------------------------------
NODE_ENV=development
# Fuso padrão das lojas (datas, dias de pico, horário de envio)
CRM_FUSO=America/Sao_Paulo

# --- Banco (PostgreSQL 16+, rodar schema.sql) ---------------
DATABASE_URL=postgresql://crm:senha@localhost:5432/crm_delivery

# --- WhatsApp Cloud API (Meta) ------------------------------
# Business Manager > WhatsApp > Configuração da API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# App > Configurações > Básico > Chave secreta do app (valida X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# Texto livre que você inventa e cola na configuração do webhook da Meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v24.0
# Limite de destinatários únicos em 24 h do portfólio (250, 2000, 10000, 100000)
WHATSAPP_LIMITE_24H=250
# Preço por mensagem de marketing, em centavos (ex.: 0.0625 USD ~ 35 centavos). Usado no ROI.
WHATSAPP_PRECO_MARKETING_CENTAVOS=

# --- Anota AI (opcional) ------------------------------------
# Portal de Integração > credenciais do parceiro
ANOTAAI_CLIENT_ID=
ANOTAAI_CLIENT_SECRET=
# Token da loja (JWT) exibido no portal; o idpage é extraído dele
ANOTAAI_TOKEN_LOJA=
ANOTAAI_LOJA_ID=

# --- Open Delivery (opcional: Delivery Direto, Saipos etc.) --
OPENDELIVERY_BASE_URL=
OPENDELIVERY_TOKEN_URL=
OPENDELIVERY_CLIENT_ID=
OPENDELIVERY_CLIENT_SECRET=
# IDs das lojas no app de pedido, separados por vírgula
OPENDELIVERY_MERCHANT_IDS=
OPENDELIVERY_LOJA_ID=

# --- Regras do motor (valores provisórios, calibrar) --------
CRM_DIAS_HIBERNACAO=3
CRM_MAX_MENSAGENS_CLIENTE_DIA=1
CRM_JANELA_ATRIBUICAO_DIAS=3
CRM_DIAS_PARA_RECUPERADO=90
